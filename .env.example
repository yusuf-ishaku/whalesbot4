# ---- Deploy-time configuration (secrets live ONLY here) ----------------------------------------
# DATABASE_URL is set by docker-compose; set it yourself only when running without Docker.
# DATABASE_URL=postgres://tokengate:password@localhost:5432/tokengate
DB_PASSWORD=change-me
PORT=3000
# Public https URL of this deployment: members open verification links here.
PUBLIC_URL=https://verify.example.com

# Telegram: create the bot with @BotFather, paste the token. Leave blank to boot without the bot.
TELEGRAM_BOT_TOKEN=

# Chain
CHAIN_ID=1
CHAIN_NAME=ethereum
RPC_URL=https://your-rpc-provider.example/key
EXPLORER_URL=

# Sources: how to read each wallet's value. Addresses live here on purpose (deliberate change).
# Token balance + staked balance example (replace addresses/ABI to match the real contracts):
SOURCES_JSON=[{"id":"token","label":"Token balance","contract":"0x0000000000000000000000000000000000000001","abi":["function balanceOf(address) view returns (uint256)"],"fn":"balanceOf","extract":{"kind":"scalar"},"decimals":18},{"id":"staked","label":"Staked","contract":"0x0000000000000000000000000000000000000002","abi":["function stakedBalance(address) view returns (uint256)"],"fn":"stakedBalance","extract":{"kind":"scalar"},"decimals":18}]

# Secrets
SESSION_SECRET=generate-with-openssl-rand-hex-32-xxxxxxxx
# First dashboard admin, created on first boot if no admin exists:
ADMIN_EMAIL=
ADMIN_PASSWORD=
8761363834:AAHtZTTJl3qljnUeB8J1aAEtLqE8r9mZalA
